# MinIO Configuration for Blog Media Uploads
# Copy this file to .env and fill in your MinIO credentials.

# MinIO Server Endpoint
# The hostname and port of your MinIO server (without protocol prefix)
# Examples:
#   - "minio.example.com:9000" (self-hosted)
#   - "s3.amazonaws.com" (AWS S3 compatible)
#   - "storage.googleapis.com" (GCS S3-compatible)
MINIO_ENDPOINT=minio.example.com:9000

# MinIO Access Key
# Your MinIO access key ID (similar to AWS Access Key ID)
MINIO_ACCESS_KEY=your-access-key-here

# MinIO Secret Key
# Your MinIO secret access key (similar to AWS Secret Access Key)
MINIO_SECRET_KEY=your-secret-key-here

# MinIO Bucket Name
# The bucket where media files will be uploaded
# This bucket will be created automatically if it doesn't exist
MINIO_BUCKET=blog-assets

# MinIO Secure Connection (Optional)
# Whether to use HTTPS for connections
# Values: "true", "1", "yes" for HTTPS; anything else for HTTP
# Default: true (HTTPS enabled)
MINIO_SECURE=true
