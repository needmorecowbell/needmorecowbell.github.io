# Generated files by hugo
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
/.hugo_build.lock

# Environment files with secrets (never commit these!)
scripts/.env
.env

# Publish tracking state (local only)
scripts/.published.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Node.js
node_modules/

# Playwright test artifacts (generated during test runs)
playwright-report/
test-results/
playwright/.cache/

# Playwright visual regression - exclude comparison outputs but KEEP baseline screenshots
# Baseline screenshots are stored in tests/ui/*.spec.ts-snapshots/ and MUST be committed
# DO NOT add tests/ui/*.spec.ts-snapshots/ to gitignore - these are the baselines!
# The following are temporary diff images generated during failed comparisons:
*-diff.png
*-actual.png
